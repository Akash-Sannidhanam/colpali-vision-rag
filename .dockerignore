# Keep the build context small: only pyproject/uv.lock and src/ are needed (see Dockerfile).
.git
.github
.venv
__pycache__
*.py[oc]

# Generated / runtime data - rebuilt inside the container or mounted
qdrant_data/
page_images/
eval/reports/

# The UI *is* baked in now (the ui-builder stage compiles it and the API serves the
# result), so ui/ has to reach the build context - but its generated directories do
# not: npm ci and vite rebuild them, and node_modules would dwarf the rest of it.
ui/node_modules/
ui/dist/

# Local-only and secrets
.env
CLAUDE.md
.claude/

# Not needed at runtime
tests/
docs/
*.md
scripts/
pdfs/
