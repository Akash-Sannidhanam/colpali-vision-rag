# Copy to .env and fill in. .env is gitignored.

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_key_here

# Qdrant server URL. Leave unset to use the embedded on-disk fallback store.
# With `docker compose up -d` running, point the app at the container:
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=            # only needed for a secured Qdrant deployment

# LangSmith tracing (optional). Off unless LANGSMITH_TRACING=true AND a key are set;
# LangGraph then emits traces natively - no code change. Traces are tagged with the
# per-query request_id that also appears in the app's structured logs.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_PROJECT=colpali-vision-rag

# --- API auth + rate limiting (src/auth.py, src/ratelimit.py) ---
# Shared secret required in the X-API-Key header on every endpoint except /health
# and /images. EMPTY DISABLES AUTH — fine locally, but set it for anything reachable
# beyond localhost: /ingest spends GPU + Gemini budget and DELETE /corpus destroys data.
# Generate one with: openssl rand -hex 24
API_KEY=
# Per-client-IP caps. 0 disables either one.
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_INGEST_PER_HOUR=10
# Read the client IP from X-Forwarded-For. Only enable behind a trusted reverse proxy —
# otherwise any client can forge it and get a fresh rate-limit bucket per request.
TRUST_PROXY_HEADERS=false
