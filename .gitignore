# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets / environment
.env

# Local agent instructions — kept out of the public repo
CLAUDE.md

# Generated artifacts (regenerate via ingest / answer time)
qdrant_data/
page_images/

# Fetched eval-corpus PDFs (regenerate: scripts/fetch_eval_corpus.py). The three demo
# documents stay tracked; everything else in pdfs/ is the distractor haystack, pinned by
# sha256 in eval/corpus_manifest.json rather than committed (~200 MB of papers).
pdfs/*.pdf
!pdfs/sales_report.pdf
!pdfs/attention.pdf
!pdfs/colpali.pdf

# Eval reports (regenerate via eval/run_eval.py; the dataset is tracked). The pinned
# baseline is the exception - a regression guard needs a committed thing to diff against.
# Note `reports/*`, not `reports/`: git never descends into an excluded *directory*, so
# the trailing-slash form would make the negation below unreachable.
eval/reports/*
# The current baseline is `baseline_swept.json` (83 questions, RERANK_K=3 - the shipped
# default - with the cross-document gold labels swept). The other three are superseded but
# kept because the write-ups cite their numbers: `baseline_rerank_k3.json` is the same
# config on the pre-sweep labels; `baseline_sharpened.json` is those 83 questions at
# RERANK_K=2, and doubles as arm A of the RERANK_K experiment; `baseline_desaturated.json`
# is the older 69-question set.
!eval/reports/baseline_swept.json
!eval/reports/baseline_rerank_k3.json
!eval/reports/baseline_sharpened.json
!eval/reports/baseline_desaturated.json
